{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-workspace-services/.github/blob/main/capabilities/schema.json",
  "title": "AI Workspace capability manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "modules"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/module"
      }
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner_repo",
        "title",
        "product",
        "editions",
        "domains",
        "surface",
        "routes",
        "api_prefixes",
        "tables",
        "depends_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "owner_repo": {
          "type": "string",
          "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "enum": ["appModules", "builtinExtension", "routeSurface"]
        },
        "product": {
          "type": "string",
          "enum": [
            "xworkmate",
            "xconnect",
            "ai-workspace",
            "open-platform",
            "global-mesh"
          ]
        },
        "editions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["selfhost", "managed", "paygo", "saas"]
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["web-saas", "ai-workspace", "agent-proxy", "open-platform"]
          }
        },
        "surface": {
          "type": "string",
          "enum": ["public", "app", "internal"]
        },
        "routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "api_prefixes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
          }
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "extension_routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/extensionRoute"
          }
        }
      }
    },
    "extensionRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "label", "guard"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "match": {
          "type": "string",
          "enum": ["exact", "startsWith"]
        },
        "sidebar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["section"],
          "properties": {
            "section": { "type": "string", "minLength": 1 },
            "order": { "type": "integer" },
            "hidden": { "type": "boolean" }
          }
        },
        "guard": {
          "$ref": "#/$defs/accessRule"
        },
        "redirect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "unauthenticated": { "type": "string", "pattern": "^/" },
            "forbidden": { "type": "string", "pattern": "^/" }
          }
        },
        "feature_flag": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "description", "env_var", "default_enabled"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "env_var": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "default_enabled": { "type": "boolean" }
          }
        }
      }
    },
    "accessRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require_login": { "type": "boolean" },
        "allow_guests": { "type": "boolean" },
        "roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["user", "operator", "admin"]
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "groups": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "tenant_scoped": { "type": "boolean" }
      }
    }
  }
}
